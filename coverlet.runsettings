<?xml version="1.0" encoding="utf-8" ?>
<!--
  Cobertura de todo o código de produção, exceto as migrations (código gerado pelo EF).
  Cada projeto de teste gera o seu relatório; scripts/coverage.sh junta os dois com o
  ReportGenerator, de modo que uma linha coberta por qualquer um dos dois conta como coberta.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[OficinaCadastros.Domain]*,[OficinaCadastros.Application]*,[OficinaCadastros.Infrastructure]*,[OficinaCadastros.API]*</Include>
          <ExcludeByFile>**/Migrations/**</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
